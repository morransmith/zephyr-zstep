# Run from the repository root: doxygen doc/Doxyfile
# Options not listed here have their default values.

PROJECT_NAME          = zstep
PROJECT_BRIEF         = "Step/dir stepper motion controller for Zephyr"
OUTPUT_DIRECTORY      = doc/build
INPUT                 = include/zstep
RECURSIVE             = YES
FILE_PATTERNS         = *.h
STRIP_FROM_PATH       = include
STRIP_FROM_INC_PATH   = include
OPTIMIZE_OUTPUT_FOR_C = YES
# The first sentence of a comment is its brief description.
JAVADOC_AUTOBRIEF     = YES
# The comment of a member group applies to each of its members.
DISTRIBUTE_GROUP_DOC  = YES
GENERATE_LATEX        = NO
QUIET                 = YES
# Every warning fails the build, an undocumented public symbol included.
WARN_AS_ERROR         = FAIL_ON_WARNINGS
