#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	fake_driver: fake-driver {
		compatible = "zephyr,fake-stepper-driver";
	};

	/* Unused, the upstream fake driver does not build warning free without it. */
	fake-ctrl {
		compatible = "zephyr,fake-stepper-ctrl";
	};

	spy: gpio-spy {
		compatible = "zstep,test-gpio-spy";
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <10>;
	};

	motor_a: motor-a {
		compatible = "zstep,step-dir";
		step-gpios = <&spy 0 GPIO_ACTIVE_HIGH>;
		dir-gpios = <&spy 1 GPIO_ACTIVE_HIGH>;
		counter = <&counter0>;
		counter-channel = <0>;
	};

	motor_b: motor-b {
		compatible = "zstep,step-dir";
		step-gpios = <&spy 2 GPIO_ACTIVE_HIGH>;
		dir-gpios = <&spy 3 GPIO_ACTIVE_HIGH>;
		counter = <&counter0>;
		counter-channel = <1>;
		invert-direction;
	};

	motor_c: motor-c {
		compatible = "zstep,step-dir";
		step-gpios = <&spy 4 GPIO_ACTIVE_HIGH>;
		dir-gpios = <&spy 5 GPIO_ACTIVE_HIGH>;
		counter = <&counter0>;
		counter-channel = <2>;
		dual-edge-step;
	};

	motor_d: motor-d {
		compatible = "zstep,step-dir";
		step-gpios = <&spy 6 GPIO_ACTIVE_HIGH>;
		dir-gpios = <&spy 7 GPIO_ACTIVE_HIGH>;
		counter = <&counter0>;
		counter-channel = <3>;
		input-shaper = "zvd";
		input-shaper-frequency-centihz = <4000>;
		input-shaper-buffer-steps = <1024>;
	};

	motor_e: motor-e {
		compatible = "zstep,step-dir";
		step-gpios = <&spy 8 GPIO_ACTIVE_HIGH>;
		dir-gpios = <&spy 9 GPIO_ACTIVE_HIGH>;
		counter = <&counter0>;
		counter-channel = <4>;
		stepper-driver = <&fake_driver>;
		input-shaper = "ei";
		input-shaper-frequency-centihz = <4000>;
		input-shaper-buffer-steps = <1024>;
	};
};
